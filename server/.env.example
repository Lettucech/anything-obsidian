# Copy to server/.env (gitignored) — every value is optional.
# The dashboard's setup wizard (http://<server>:21500) collects the
# AnythingLLM developer key and the gateway admin credential into the data
# volume on first run, so this file can stay empty.

# Optional overrides (non-interactive deployments / CI):
# ANYTHINGLLM_API_KEY=      # skip the wizard; gateway becomes key holder directly
# GATEWAY_ADMIN_TOKEN=      # fixed admin credential instead of the wizard-minted one
# GATEWAY_BOOTSTRAP_TOKEN=  # fixed one-time setup token (else generated into container logs)
# SHARED_WORKSPACE_SLUG=shared

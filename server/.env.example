# Copy to server/.env (gitignored) and fill in before the second compose up.
# The gateway is the sole holder of the AnythingLLM developer API key — the
# key never appears in any client config on user machines.

# From AnythingLLM: open its UI once (server-local or SSH tunnel), finish the
# first-boot setup, then Settings -> Developer API -> generate an API key.
ANYTHINGLLM_API_KEY=

# This one is yours to create: any long random secret that becomes the
# gateway's own admin credential. Generate one, e.g.:
#   openssl rand -base64 32
GATEWAY_ADMIN_TOKEN=

# Optional: slug of the shared workspace the gateway manages (default shared).
# SHARED_WORKSPACE_SLUG=shared

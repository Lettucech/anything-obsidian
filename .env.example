# AnythingLLM user settings
ANYTHINGLLM_API_KEY=
# The parent directory for vaults managed by the dashboard. It may start empty.
HOST_VAULTS_ROOT=/Users/you/.anything-obsidian/vaults

# Host ports used by Docker Compose.
HOST_DASHBOARD_PORT=11300
HOST_ANYTHINGLLM_PORT=11301
HOST_MCP_PORT=11333

# Optional Git defaults. Configure a private-repository token only when a vault needs it.
KB_GIT_AUTO_PULL=true
KB_GIT_AUTO_PUSH=true
KB_GIT_USER_NAME=anything-obsidian
KB_GIT_USER_EMAIL=anything-obsidian@local
KB_GIT_AUTH_USERNAME=x-access-token
KB_GIT_AUTH_TOKEN=

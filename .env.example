# AnythingLLM user settings
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_SLUG=obsidian

# Vault host path used by Docker Compose.
HOST_VAULT_PATH=/Users/lettucech/Documents/vault

# Host ports used by Docker Compose.
HOST_ANYTHINGLLM_PORT=11301
HOST_MCP_PORT=11333

# Auto sync user settings
KB_WATCH_INTERVAL_SECONDS=300
KB_SYNC_DEBOUNCE_SECONDS=300
KB_GIT_REMOTE=origin
KB_GIT_BRANCH=main
KB_GIT_AUTO_PULL=true
KB_GIT_AUTO_PUSH=true
KB_GIT_USER_NAME=anything-obsidian
KB_GIT_USER_EMAIL=anything-obsidian@local

# Optional. Use when the container cannot authenticate with the vault repo's normal remote.
# Example: https://x-access-token:YOUR_TOKEN@github.com/YOUR_ACCOUNT/YOUR_VAULT_REPO.git
KB_GIT_PUSH_URL=

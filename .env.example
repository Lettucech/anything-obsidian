# Generate this in AnythingLLM: Settings > Developer API, then keep the real value only in .env.
ANYTHINGLLM_API_KEY=replace-with-your-anythingllm-api-key
# The parent directory for vaults managed by the dashboard. It may start empty.
HOST_VAULTS_ROOT=/Users/you/.anything-obsidian/vaults

# Host ports used by Docker Compose.
HOST_DASHBOARD_PORT=11300
HOST_ANYTHINGLLM_PORT=11301
HOST_MCP_PORT=11333

# Optional LAN RAG-only MCP. This is disabled until you run Compose with --profile lan.
HOST_MCP_LAN_PORT=11334
# Use a long random value and keep it local. LAN clients must send it as Authorization: Bearer <token>.
MCP_LAN_TOKEN=replace-with-a-long-random-token
# Comma-separated Host headers accepted by the LAN MCP, for example: obsidian-host.local,192.168.1.10
MCP_LAN_ALLOWED_HOSTS=obsidian-host.local

#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/.env.example" ]]; then
  ROOT="$SCRIPT_DIR"
else
  ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
cd "$ROOT"

usage() {
  cat <<'USAGE'
Usage: ./scripts/kb <command>

Commands:
  init              Create .env from .env.example when missing
  start             Start core AnythingLLM only
  start-mcp         Build and start optional MCP server
  start-sync        Build and start auto sync watcher
  stop              Stop local services
  restart           Restart local services
  logs              Follow service logs
  status            Show Git and container status
  embed [--all]     Run Docker embed job for changed vault files
  verify            Check Docker services and AnythingLLM API access
  set-env KEY VALUE Set or append a value in .env
  url TARGET        Print service URL: anythingllm or mcp
  verify-key        Check AnythingLLM API key access
  setup-fallback    Print manual first-run steps
USAGE
}

compose() {
  if [[ -f .env ]]; then
    docker compose --env-file .env -f docker/anythingllm/compose.yml "$@"
  else
    docker compose --env-file .env.example -f docker/anythingllm/compose.yml "$@"
  fi
}

compose_mcp() {
  if [[ -f .env ]]; then
    docker compose --env-file .env -f docker/mcp/compose.yml "$@"
  else
    docker compose --env-file .env.example -f docker/mcp/compose.yml "$@"
  fi
}

load_env() {
  if [[ -f .env ]]; then
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
  fi
}

ensure_env() {
  if [[ ! -f .env ]]; then
    echo "Missing .env. Run: ./scripts/kb init" >&2
    exit 1
  fi
}

set_env_value() {
  local key="$1"
  local value="$2"
  local quoted_value
  local tmp

  if [[ ! "$key" =~ ^[A-Z0-9_]+$ ]]; then
    echo "Invalid env key: $key" >&2
    exit 2
  fi

  quoted_value="$(quote_env_value "$value")"
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN

  if [[ -f .env ]] && grep -q "^${key}=" .env; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      case "$line" in
        "${key}="*) printf '%s=%s\n' "$key" "$quoted_value" ;;
        *) printf '%s\n' "$line" ;;
      esac
    done < .env > "$tmp"
  else
    [[ -f .env ]] && cp .env "$tmp"
    printf '%s=%s\n' "$key" "$quoted_value" >> "$tmp"
  fi

  mv "$tmp" .env
  trap - RETURN
}

quote_env_value() {
  local value="$1"
  local quoted='"'
  local char
  local i

  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    echo "Env values must be single-line." >&2
    exit 2
  fi

  for ((i = 0; i < ${#value}; i += 1)); do
    char="${value:i:1}"
    case "$char" in
      "\\") quoted+='\\' ;;
      '"') quoted+='\"' ;;
      '$') quoted+='\$' ;;
      '`') quoted+='\`' ;;
      *) quoted+="$char" ;;
    esac
  done

  printf '%s"\n' "$quoted"
}

anythingllm_url() {
  load_env
  printf 'http://localhost:%s\n' "${HOST_ANYTHINGLLM_PORT:-11301}"
}

mcp_url() {
  load_env
  printf 'http://localhost:%s/mcp\n' "${HOST_MCP_PORT:-11333}"
}

verify_api_key() {
  ensure_env
  load_env
  if [[ -z "${ANYTHINGLLM_API_KEY:-}" ]]; then
    echo "ANYTHINGLLM_API_KEY is empty." >&2
    exit 1
  fi

  anythingllm_base_url="${ANYTHINGLLM_BASE_URL:-http://localhost:${HOST_ANYTHINGLLM_PORT:-11301}}"
  curl --fail --silent --show-error \
    -H "Authorization: Bearer ${ANYTHINGLLM_API_KEY}" \
    "${anythingllm_base_url}${ANYTHINGLLM_WORKSPACES_PATH:-/api/v1/workspaces}" >/dev/null
}

case "${1:-}" in
  init)
    if [[ -f .env ]]; then
      echo ".env already exists"
    else
      cp .env.example .env
      echo "Created .env. Edit it before running ./scripts/kb start."
    fi
    ;;
  start)
    ensure_env
    compose up -d
    ;;
  start-mcp)
    ensure_env
    load_env
    if [[ -z "${ANYTHINGLLM_API_KEY:-}" ]]; then
      echo "ANYTHINGLLM_API_KEY is empty. Create an API key in AnythingLLM and add it to .env first." >&2
      exit 1
    fi
    compose_mcp up -d --build mcp
    ;;
  start-sync)
    ensure_env
    load_env
    if [[ -z "${ANYTHINGLLM_API_KEY:-}" ]]; then
      echo "ANYTHINGLLM_API_KEY is empty. Create an API key in AnythingLLM and add it to .env first." >&2
      exit 1
    fi
    compose_mcp up -d --build sync
    ;;
  stop)
    compose_mcp down
    compose down
    ;;
  restart)
    ensure_env
    load_env
    compose_mcp down
    compose up -d
    if [[ -n "${ANYTHINGLLM_API_KEY:-}" ]]; then
      compose_mcp up -d --build mcp
    fi
    ;;
  logs)
    compose_mcp logs -f
    ;;
  status)
    git status --short --branch
    compose ps
    load_env
    if [[ -n "${ANYTHINGLLM_API_KEY:-}" ]]; then
      compose_mcp ps
    fi
    ;;
  embed)
    ensure_env
    load_env
    if [[ -z "${ANYTHINGLLM_API_KEY:-}" ]]; then
      echo "ANYTHINGLLM_API_KEY is empty. Create an API key in AnythingLLM and add it to .env first." >&2
      exit 1
    fi
    shift
    if [[ "$#" -gt 0 ]]; then
      compose_mcp run --rm embed node scripts/embed-vault.mjs "$@"
    else
      compose_mcp run --rm embed
    fi
    ;;
  verify)
    ensure_env
    load_env
    anythingllm_base_url="${ANYTHINGLLM_BASE_URL:-http://localhost:${HOST_ANYTHINGLLM_PORT:-11301}}"
    compose_mcp ps
    curl --fail --silent --show-error "${anythingllm_base_url}/api/docs" >/dev/null
    curl --fail --silent --show-error "http://localhost:${HOST_MCP_PORT:-11333}/health" >/dev/null
    if [[ -z "${ANYTHINGLLM_API_KEY:-}" ]]; then
      echo "ANYTHINGLLM_API_KEY is empty. Create an API key in AnythingLLM and add it to .env." >&2
      exit 1
    fi
    compose_mcp exec -T mcp sh -c 'test -n "$ANYTHINGLLM_API_KEY"'
    curl --fail --silent --show-error \
      -H "Authorization: Bearer ${ANYTHINGLLM_API_KEY}" \
      "${anythingllm_base_url}${ANYTHINGLLM_WORKSPACES_PATH:-/api/v1/workspaces}" >/dev/null
    echo "AnythingLLM, MCP server, and API key are reachable."
    ;;
  set-env)
    ensure_env
    if [[ "$#" -ne 3 ]]; then
      echo "Usage: ./scripts/kb set-env KEY VALUE" >&2
      exit 2
    fi
    set_env_value "$2" "$3"
    ;;
  url)
    case "${2:-}" in
      anythingllm) anythingllm_url ;;
      mcp) mcp_url ;;
      *)
        echo "Usage: ./scripts/kb url anythingllm|mcp" >&2
        exit 2
        ;;
    esac
    ;;
  verify-key)
    verify_api_key
    echo "AnythingLLM API key is valid."
    ;;
  setup-fallback)
    ensure_env
    echo "1. Run: ./scripts/kb start"
    echo "2. Open: $(anythingllm_url)"
    echo "3. Finish AnythingLLM setup and create an API key."
    echo "4. Run: ./scripts/kb set-env ANYTHINGLLM_API_KEY <key>"
    echo "5. Run: ./scripts/kb start-mcp"
    echo "6. Run: ./scripts/kb verify"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
